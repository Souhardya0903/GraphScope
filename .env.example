# Loaded by the graph client; shell environment variables take precedence.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_USERNAME=
# Enable only when the endpoint supports TLS; certificates are validated.
FALKORDB_SSL=false
FALKORDB_GRAPH=graphscope
GRAPHSCOPE_REPOSITORY_PATH=examples/commerce
GRAPHSCOPE_MAX_DEPTH=8
GRAPHSCOPE_MAX_PATHS=100
# Optional Stage 4 OpenAI configuration. Default CLI mode makes no model calls.
OPENAI_API_KEY=
# Set a model ID available to your account; no paid API calls run by default.
OPENAI_MODEL=
# Gemini alternative; use a model available to your account and free-tier quota.
GEMINI_API_KEY=
GEMINI_MODEL=
# Ollama Cloud alternative; use a direct API model ID from ollama.com/api/tags.
OLLAMA_API_KEY=
OLLAMA_MODEL=
